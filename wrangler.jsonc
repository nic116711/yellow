{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yellow",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "aaf12e3a-e837-497c-9228-32db4ac37159","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "160272e897254eeea1a2426c96f778f8" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
